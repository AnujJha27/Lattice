# ── Supabase (project settings → API) ─────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# anon key: safe for browser; used by the web app
SUPABASE_ANON_KEY=replace_me
# service role: server-only, NEVER expose to the client or commit
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_STORAGE_BUCKET=lattice-private
# Comma-separated emails allowed in production (enforced by the API).
ALLOWED_EMAILS=

# Postgres connection string for Alembic + SQLAlchemy.
# Supabase → Connect → Session pooler (port 5432, uses your DB password)
DATABASE_URL=postgresql+asyncpg://postgres:replace_me@aws-0-region.pooler.supabase.com:5432/postgres

# ── AI providers ───────────────────────────────────────────────────
GOOGLE_API_KEY=replace_me          # Gemini — lessons, pathways, tutor, embeddings
GOOGLE_API_KEYS=                   # optional comma-separated backup Gemini keys

# ── Source discovery ───────────────────────────────────────────────
TAVILY_API_KEY=replace_me          # general web search (free tier)
# arXiv + OpenAlex need no keys

# ── App ────────────────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:3000   # CORS allow-list
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO
GEMINI_MODEL=gemini-2.5-flash      # structured-output-capable Gemini model
OPENROUTER_API_KEY=replace_me         # optional; free models via openrouter.ai
OPENROUTER_MODEL=z-ai/glm-5.2:free   # see openrouter.ai/models?q=free
